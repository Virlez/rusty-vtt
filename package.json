{
  "name": "rusty-vtt-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "cargo test --locked",
    "test:mutation": "cargo mutants",
    "test:integration": "cargo build --locked && node tests/run-integration.mjs",
    "test:e2e": "cargo build --locked && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint web tests scripts *.config.js",
    "format": "prettier --write \"web/**/*.js\" \"tests/**/*.js\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.config.js\" package.json",
    "format:check": "prettier --check \"web/**/*.js\" \"tests/**/*.js\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.config.js\" package.json",
    "check": "npm run lint && npm run format:check",
    "test:coverage": "node scripts/coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
